# Dockerfile para Servir la Exportación Web (HTML5) en Coolify
FROM nginx:alpine

# Copiar configuración personalizada con cabeceras COOP y COEP
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# Carpeta donde se colocarán los archivos generados por la exportación web de Godot
# (index.html, index.js, index.wasm, index.pck)
COPY export/web/ /usr/share/nginx/html/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
